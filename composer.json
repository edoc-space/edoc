{
    "name": "phpsoftbox/app-backend",
    "description": "Backend application skeleton for PhpSoftBox",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "phpsoftbox/application": "^1",
        "phpsoftbox/cache": "^1",
        "phpsoftbox/cli-app": "^1",
        "phpsoftbox/collection": "^1",
        "phpsoftbox/config": "^1",
        "phpsoftbox/container": "^1",
        "phpsoftbox/cookie": "^1",
        "phpsoftbox/encryptor": "^1",
        "phpsoftbox/env": "^1",
        "phpsoftbox/http-emitter": "^1",
        "phpsoftbox/http-message": "^1",
        "phpsoftbox/inertia": "^1",
        "phpsoftbox/inflector": "^1",
        "phpsoftbox/markdown": "^1",
        "phpsoftbox/mdx": "^1",
        "phpsoftbox/request": "^1",
        "phpsoftbox/resource": "^1",
        "phpsoftbox/router": "^1",
        "phpsoftbox/session": "^1",
        "phpsoftbox/storage": "^1",
        "phpsoftbox/validator": "^1",
        "phpsoftbox/vite": "^1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/test-utils": "^1",
        "phpunit/phpunit": "^11.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff",
        "app:prepare-env": "@php -r \"is_dir('config/env') || mkdir('config/env', 0775, true); file_exists('config/env/.env') || copy('config/env/.env.example', 'config/env/.env');\"",
        "app:prepare-local": "@php -r \"is_dir('local') || mkdir('local', 0775, true); chmod('local', 0775);\"",
        "post-install-cmd": [
            "@app:prepare-local"
        ],
        "post-update-cmd": [
            "@app:prepare-local"
        ],
        "post-create-project-cmd": [
            "@app:prepare-env",
            "@app:prepare-local"
        ]
    }
}
